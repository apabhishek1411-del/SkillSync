# ── SkillSphere — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SkillSphere
APP_ENV=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_secret

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://skillhub:skillhub123@localhost:5432/skillhub
DATABASE_URL_SYNC=postgresql://skillhub:skillhub123@localhost:5432/skillhub

# ── Redis (optional — not currently used) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── College Domain ───────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=ceconline.edu

# ── Admin (only used for initial seed — change password after first login) ──
ADMIN_EMAIL=admin@ceconline.edu
ADMIN_PASSWORD=Admin@123

# ── Razorpay Payment Gateway ────────────────────────────────────────────────
# Leave empty or set to 'mock' for local development & campus test checkout simulation
# For live testing, provide test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
